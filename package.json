{
  "name": "operations-agency-platform",
  "productName": "المنصة الجغرافية المرجعية",
  "version": "2.3.0",
  "description": "المنصة الجغرافية المرجعية V2.3 — برنامج سطح المكتب",
  "main": "main.js",
  "author": "Operations Agency",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.operations.agency.platform",
    "productName": "المنصة الجغرافية المرجعية",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "المنصة الجغرافية المرجعية",
      "language": "1025",
      "artifactName": "Taif-Geo-Platform-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Taif-Geo-Platform-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  }
}